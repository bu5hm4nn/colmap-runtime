+// The reference calibration used to be module-scope __constant__ globals
+// (`ref_K` / `ref_inv_K`). That state is shared by every PatchMatchCuda
+// instance in a process, so two patch-match workers on the same device
+// overwrite each other's calibration. The calibration is now passed per launch
+// as an immutable kernel argument and threaded through the device helpers that
+// read it. Values, arithmetic and operation order are unchanged.
+//
+// A kernel parameter declared as `float ref_K[4]` would decay to a pointer,
+// and the caller holds the calibration in host memory, so the address copied
+// into the launch parameter block would be a host pointer. Wrapping the four
+// values in a small struct makes CUDA copy them into the kernel parameter
+// space by value instead.
+struct RefCalibration {
+  float K[4];
+  float inv_K[4];
+};
+
+// Host-side helper: snapshot one rotated calibration into a launch argument.
+static RefCalibration MakeRefCalibration(const float* K, const float* inv_K) {
+  RefCalibration calibration;
+  for (int i = 0; i < 4; ++i) {
+    calibration.K[i] = K[i];
+    calibration.inv_K[i] = inv_K[i];
+  }
+  return calibration;
+}
 
